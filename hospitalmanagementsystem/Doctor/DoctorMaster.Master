<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="DoctorMaster.master.cs"
    Inherits="Hospital_Management_System_01.Doctor.DoctorMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Medilab - Doctor Panel</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f8fc;
        }

        /* TOP HEADER */
        .top-header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 70px;
            background: #1977cc;
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            z-index: 1000;
        }

        .logo {
            font-size: 28px;
            font-weight: bold;
        }

        .doctor-user {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .doctor-user i {
            font-size: 32px;
        }

        /* SIDEBAR */
        .sidebar {
            position: fixed;
            left: 0;
            top: 70px;
            width: 250px;
            height: calc(100vh - 70px);
            background: #172536;
            padding-top: 20px;
            z-index: 999;
            overflow-y: auto;
        }

        .sidebar-title {
            color: white;
            font-size: 18px;
            padding: 15px 25px;
            font-weight: bold;
        }

        .sidebar a {
            display: block;
            color: #dbe7f5;
            text-decoration: none;
            padding: 14px 25px;
            font-size: 16px;
        }

        .sidebar a:hover {
            background: #1977cc;
            color: white;
        }

        .sidebar a i {
            margin-right: 15px;
        }

        .logout {
            position: absolute;
            bottom: 20px;
            width: 100%;
        }

        /* MAIN */
        .main-content {
            margin-left: 250px;
            padding: 100px 30px 30px 30px;
            min-height: 100vh;
        }

        .page-title {
            font-size: 30px;
            font-weight: bold;
            color: #17365d;
        }

        .welcome {
            color: #58708d;
            margin-bottom: 25px;
        }
    </style>
</head>
<body>
<form id="form1" runat="server">

    <!-- TOP HEADER -->
    <div class="top-header">
        <div class="logo">
            <i class="bi bi-hospital"></i>
            Medilab
        </div>
        <div class="doctor-user">
            <i class="bi bi-bell"></i>
            <i class="bi bi-person-circle"></i>
            <div>
                <b>Doctor</b>
                <br />
                <small>doctor@medilab.com</small>
            </div>
        </div>
    </div>

    <!-- SIDEBAR -->
    <div class="sidebar">
        <div class="sidebar-title">
            <i class="bi bi-person-badge-fill"></i>
            Doctor Panel
        </div>

        <a href="DoctorDashboard.aspx">
            <i class="bi bi-house-fill"></i>
            Dashboard
        </a>
        <a href="DoctorProfile.aspx">
            <i class="bi bi-person-circle"></i>
            My Profile
        </a>
        <a href="DoctorAppointments.aspx">
            <i class="bi bi-calendar-check-fill"></i>
            My Appointments
        </a>
        <a href="DoctorPatients.aspx">
            <i class="bi bi-people-fill"></i>
            Patients
        </a>
        <a href="DoctorPrescriptions.aspx">
            <i class="bi bi-capsule"></i>
            Prescriptions
        </a>
        <a href="AppointmentHistory.aspx">
            <i class="bi bi-clock-history"></i>
            Appointment History
        </a>

        <div class="logout">
            <a href="../Login.aspx">
                <i class="bi bi-box-arrow-right"></i>
                Logout
            </a>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </div>

</form>
</body>
</html>